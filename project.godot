; Engine configuration file.
; Yugen EOS wrapper demo project.

config_version=5

[application]

config/name="Yugen EOS"
config/description="Epic Online Services wrapper for Godot 4."
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

EOS="*res://addons/yugen_eos/eos_autoload.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[dotnet]

project/assembly_name="YugenEos"

[rendering]

renderer/rendering_method="gl_compatibility"
